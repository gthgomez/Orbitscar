{
  "name": "orbitscar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room prototype foundation for Project Orbitscar.",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "simulate": "tsx packages/simulation/src/cli.ts",
    "validate:content": "tsx packages/content/src/validate.ts",
    "build:web": "pnpm --filter @orbitscar/web build",
    "check": "pnpm typecheck && pnpm typecheck:web && pnpm validate:content && pnpm test && pnpm build:web",
    "test:browser": "playwright test",
    "evaluate": "tsx packages/evaluation/src/cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
